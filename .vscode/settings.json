{
  "files.associations": { "*.v": "verilog", "*.vh": "verilog", "*.sv": "systemverilog" },
  "files.exclude": { "**/build": true },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "verilog.linting.linter": "iverilog",
  "verilog.linting.iverilog.runAtFileLocation": true,
  "verilog.linting.iverilog.arguments": "-g2012 -Wno-timescale -I ."
}
