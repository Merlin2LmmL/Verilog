{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verilog: run current file's folder",
      "type": "shell",
      "command": "${workspaceFolder}/sim.sh \"${file}\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "iverilog",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):\\s+(error|warning):?\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "Verilog: open waveform (gtkwave)",
      "type": "shell",
      "command": "${workspaceFolder}/wave.sh \"${file}\"",
      "problemMatcher": []
    },
    {
      "label": "CPU: run program with trace",
      "type": "shell",
      "command": "bash ${workspaceFolder}/CPU/run.sh -t \"${file}\"",
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared"
      },
      "problemMatcher": {
        "owner": "asm",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):\\s+(error|warning):?\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "CPU: run program and open waveform",
      "type": "shell",
      "command": "bash ${workspaceFolder}/CPU/run.sh -w \"${file}\" && ${workspaceFolder}/wave.sh \"${file}\"",
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}