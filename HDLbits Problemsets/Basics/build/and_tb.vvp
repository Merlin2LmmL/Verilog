:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x612a38bf5490 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x612a38bf5620 .scope module, "and_tb" "and_tb" 3 5;
 .timescale -9 -12;
v0x612a38c436f0_0 .var "a", 0 0;
v0x612a38c437c0_0 .var "b", 0 0;
v0x612a38c43890_0 .var/i "errors", 31 0;
v0x612a38c43960_0 .var/i "i", 31 0;
v0x612a38c43a20_0 .net "out", 0 0, L_0x612a38c43b10;  1 drivers
S_0x612a38c2e890 .scope module, "dut" "top_module" 3 10, 4 3 0, S_0x612a38bf5620;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "out";
L_0x612a38c43b10 .functor AND 1, v0x612a38c436f0_0, v0x612a38c437c0_0, C4<1>, C4<1>;
v0x612a38c2eac0_0 .net "a", 0 0, v0x612a38c436f0_0;  1 drivers
v0x612a38c43330_0 .net "b", 0 0, v0x612a38c437c0_0;  1 drivers
v0x612a38c433f0_0 .net "out", 0 0, L_0x612a38c43b10;  alias, 1 drivers
S_0x612a38c43510 .scope task, "run" "run" 3 12, 3 12 0, S_0x612a38bf5620;
 .timescale -9 -12;
TD_and_tb.run ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x612a38c43960_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x612a38c43960_0;
    %cmpi/s 4, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x612a38c43960_0;
    %parti/s 2, 0, 2;
    %split/vec4 1;
    %store/vec4 v0x612a38c437c0_0, 0, 1;
    %store/vec4 v0x612a38c436f0_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x612a38c43a20_0;
    %load/vec4 v0x612a38c436f0_0;
    %flag_set/vec4 8;
    %flag_get/vec4 8;
    %jmp/0 T_0.4, 8;
    %load/vec4 v0x612a38c437c0_0;
    %and;
T_0.4;
    %cmp/ne;
    %jmp/0xz  T_0.2, 6;
    %vpi_call/w 3 17 "$display", "FAIL a=%b b=%b out=%b", v0x612a38c436f0_0, v0x612a38c437c0_0, v0x612a38c43a20_0 {0 0 0};
    %load/vec4 v0x612a38c43890_0;
    %addi 1, 0, 32;
    %store/vec4 v0x612a38c43890_0, 0, 32;
T_0.2 ;
    %load/vec4 v0x612a38c43960_0;
    %addi 1, 0, 32;
    %store/vec4 v0x612a38c43960_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %end;
    .scope S_0x612a38bf5620;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x612a38c43890_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x612a38bf5620;
T_2 ;
    %vpi_call/w 3 24 "$dumpfile", "and.vcd" {0 0 0};
    %vpi_call/w 3 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x612a38bf5620 {0 0 0};
    %fork TD_and_tb.run, S_0x612a38c43510;
    %join;
    %load/vec4 v0x612a38c43890_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.0, 4;
    %vpi_call/w 3 27 "$display", "PASS: all tests passed" {0 0 0};
    %jmp T_2.1;
T_2.0 ;
    %vpi_call/w 3 28 "$display", "FAILED: %0d mismatches", v0x612a38c43890_0 {0 0 0};
T_2.1 ;
    %vpi_call/w 3 29 "$finish" {0 0 0};
    %end;
    .thread T_2;
