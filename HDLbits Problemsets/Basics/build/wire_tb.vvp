S_0x576954fba790 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x576954fba920 .scope module, "wire_tb" "wire_tb" 3 5;
 .timescale -9 -12;
v0x576954fce5a0_0 .var "a", 0 0;
v0x576954fce640_0 .net "b", 0 0, L_0x576954fce8a0;  1 drivers
v0x576954fce710_0 .var/i "errors", 31 0;
v0x576954fce7e0_0 .var/i "i", 31 0;
S_0x576954f81490 .scope module, "dut" "wire_module" 3 10, 4 3 0, S_0x576954fba920;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /OUTPUT 1 "b";
L_0x576954fce8a0 .functor BUFZ 1, v0x576954fce5a0_0, C4<0>, C4<0>, C4<0>;
v0x576954f81620_0 .net "a", 0 0, v0x576954fce5a0_0;  1 drivers
v0x576954fce2a0_0 .net "b", 0 0, L_0x576954fce8a0;  alias, 1 drivers
S_0x576954fce3c0 .scope task, "run" "run" 3 12, 3 12 0, S_0x576954fba920;
 .timescale -9 -12;
TD_wire_tb.run ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x576954fce7e0_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x576954fce7e0_0;
    %cmpi/s 2, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x576954fce7e0_0;
    %parti/s 1, 0, 2;
    %store/vec4 v0x576954fce5a0_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x576954fce640_0;
    %load/vec4 v0x576954fce5a0_0;
    %cmp/ne;
    %jmp/0xz  T_0.2, 6;
    %vpi_call/w 3 17 "$display", "FAIL a=%b b=%b", v0x576954fce5a0_0, v0x576954fce640_0 {0 0 0};
    %load/vec4 v0x576954fce710_0;
    %addi 1, 0, 32;
    %store/vec4 v0x576954fce710_0, 0, 32;
T_0.2 ;
    %load/vec4 v0x576954fce7e0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x576954fce7e0_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %end;
    .scope S_0x576954fba920;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x576954fce710_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x576954fba920;
T_2 ;
    %vpi_call/w 3 24 "$dumpfile", "wire.vcd" {0 0 0};
    %vpi_call/w 3 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x576954fba920 {0 0 0};
    %fork TD_wire_tb.run, S_0x576954fce3c0;
    %join;
    %load/vec4 v0x576954fce710_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.0, 4;
    %vpi_call/w 3 27 "$display", "PASS: all tests passed" {0 0 0};
    %jmp T_2.1;
T_2.0 ;
    %vpi_call/w 3 28 "$display", "FAILED: %0d mismatches", v0x576954fce710_0 {0 0 0};
T_2.1 ;
    %vpi_call/w 3 29 "$finish" {0 0 0};
    %end;
    .thread T_2;
