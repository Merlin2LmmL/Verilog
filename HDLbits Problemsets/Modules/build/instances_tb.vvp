#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fbf2d5e4bb0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5fbf2d5e4d40 .scope module, "instances_tb" "instances_tb" 3 5;
 .timescale -9 -12;
v0x5fbf2d5fcb80_0 .var "a", 0 0;
v0x5fbf2d5fcc70_0 .var "b", 0 0;
v0x5fbf2d5fcd80_0 .var/i "errors", 31 0;
v0x5fbf2d5fce20_0 .var/i "i", 31 0;
v0x5fbf2d5fcf00_0 .net "out", 0 0, L_0x5fbf2d5fd040;  1 drivers
S_0x5fbf2d5ab490 .scope module, "dut" "top_module" 3 10, 4 1 0, S_0x5fbf2d5e4d40;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "out";
v0x5fbf2d5fc710_0 .net "a", 0 0, v0x5fbf2d5fcb80_0;  1 drivers
v0x5fbf2d5fc7d0_0 .net "b", 0 0, v0x5fbf2d5fcc70_0;  1 drivers
v0x5fbf2d5fc8a0_0 .net "out", 0 0, L_0x5fbf2d5fd040;  alias, 1 drivers
S_0x5fbf2d5ab6c0 .scope module, "instance1" "mod_a" 4 2, 4 13 0, S_0x5fbf2d5ab490;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "in1";
    .port_info 1 /INPUT 1 "in2";
    .port_info 2 /INPUT 1 "in3";
    .port_info 3 /INPUT 1 "in4";
    .port_info 4 /OUTPUT 1 "out1";
    .port_info 5 /OUTPUT 1 "out2";
L_0x5fbf2d5fd040 .functor OR 1, v0x5fbf2d5fcb80_0, v0x5fbf2d5fcc70_0, C4<0>, C4<0>;
o0x76f24d2e1078 .functor BUFZ 1, C4<z>; HiZ drive
o0x76f24d2e10a8 .functor BUFZ 1, C4<z>; HiZ drive
L_0x5fbf2d5fd0f0 .functor OR 1, o0x76f24d2e1078, o0x76f24d2e10a8, C4<0>, C4<0>;
v0x5fbf2d5e4ed0_0 .net "in1", 0 0, v0x5fbf2d5fcb80_0;  alias, 1 drivers
v0x5fbf2d5fc260_0 .net "in2", 0 0, v0x5fbf2d5fcc70_0;  alias, 1 drivers
v0x5fbf2d5fc320_0 .net "in3", 0 0, o0x76f24d2e1078;  0 drivers
v0x5fbf2d5fc3c0_0 .net "in4", 0 0, o0x76f24d2e10a8;  0 drivers
v0x5fbf2d5fc480_0 .net "out1", 0 0, L_0x5fbf2d5fd040;  alias, 1 drivers
v0x5fbf2d5fc590_0 .net "out2", 0 0, L_0x5fbf2d5fd0f0;  1 drivers
S_0x5fbf2d5fc9a0 .scope task, "run" "run" 3 12, 3 12 0, S_0x5fbf2d5e4d40;
 .timescale -9 -12;
TD_instances_tb.run ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5fbf2d5fce20_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x5fbf2d5fce20_0;
    %cmpi/s 4, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x5fbf2d5fce20_0;
    %parti/s 2, 0, 2;
    %split/vec4 1;
    %store/vec4 v0x5fbf2d5fcc70_0, 0, 1;
    %store/vec4 v0x5fbf2d5fcb80_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5fbf2d5fcf00_0;
    %load/vec4 v0x5fbf2d5fcb80_0;
    %load/vec4 v0x5fbf2d5fcc70_0;
    %or;
    %cmp/ne;
    %jmp/0xz  T_0.2, 6;
    %vpi_call/w 3 17 "$display", "FAIL a=%b b=%b out=%b", v0x5fbf2d5fcb80_0, v0x5fbf2d5fcc70_0, v0x5fbf2d5fcf00_0 {0 0 0};
    %load/vec4 v0x5fbf2d5fcd80_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5fbf2d5fcd80_0, 0, 32;
T_0.2 ;
    %load/vec4 v0x5fbf2d5fce20_0;
    %addi 1, 0, 32;
    %store/vec4 v0x5fbf2d5fce20_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %end;
    .scope S_0x5fbf2d5e4d40;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5fbf2d5fcd80_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_0x5fbf2d5e4d40;
T_2 ;
    %vpi_call/w 3 24 "$dumpfile", "instances.vcd" {0 0 0};
    %vpi_call/w 3 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fbf2d5e4d40 {0 0 0};
    %fork TD_instances_tb.run, S_0x5fbf2d5fc9a0;
    %join;
    %load/vec4 v0x5fbf2d5fcd80_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_2.0, 4;
    %vpi_call/w 3 27 "$display", "PASS: all tests passed" {0 0 0};
    %jmp T_2.1;
T_2.0 ;
    %vpi_call/w 3 28 "$display", "FAILED: %0d mismatches", v0x5fbf2d5fcd80_0 {0 0 0};
T_2.1 ;
    %vpi_call/w 3 29 "$finish" {0 0 0};
    %end;
    .thread T_2;
