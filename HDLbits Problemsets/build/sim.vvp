#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x62a78e3a1490 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x62a78e3a1620 .scope module, "and_gate_tb" "and_gate_tb" 3 3;
 .timescale -9 -12;
v0x62a78e3ed280_0 .var "a", 0 0;
v0x62a78e3ed350_0 .var "b", 0 0;
v0x62a78e3ed420_0 .var/i "i", 31 0;
v0x62a78e3ed4f0_0 .net "y", 0 0, L_0x62a78e3ed5c0;  1 drivers
S_0x62a78e3dd000 .scope module, "dut" "and_gate" 3 7, 4 2 0, S_0x62a78e3a1620;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x62a78e3ed5c0 .functor AND 1, v0x62a78e3ed280_0, v0x62a78e3ed350_0, C4<1>, C4<1>;
v0x62a78e3dd640_0 .net "a", 0 0, v0x62a78e3ed280_0;  1 drivers
v0x62a78e3ed0a0_0 .net "b", 0 0, v0x62a78e3ed350_0;  1 drivers
v0x62a78e3ed160_0 .net "y", 0 0, L_0x62a78e3ed5c0;  alias, 1 drivers
    .scope S_0x62a78e3a1620;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "waves.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x62a78e3a1620 {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x62a78e3ed420_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x62a78e3ed420_0;
    %cmpi/s 4, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x62a78e3ed420_0;
    %parti/s 2, 0, 2;
    %split/vec4 1;
    %store/vec4 v0x62a78e3ed350_0, 0, 1;
    %store/vec4 v0x62a78e3ed280_0, 0, 1;
    %delay 10000, 0;
    %vpi_call/w 3 17 "$display", "a=%b b=%b -> y=%b", v0x62a78e3ed280_0, v0x62a78e3ed350_0, v0x62a78e3ed4f0_0 {0 0 0};
    %load/vec4 v0x62a78e3ed420_0;
    %addi 1, 0, 32;
    %store/vec4 v0x62a78e3ed420_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %vpi_call/w 3 19 "$finish" {0 0 0};
    %end;
    .thread T_0;
